/* =========================================
   RUNNER X 3D
   Original 3D Endless Runner
========================================= */

const scene = new THREE.Scene();

scene.background =
    new THREE.Color(0x78b9e8);

scene.fog =
    new THREE.Fog(
        0x78b9e8,
        40,
        180
    );


/* =========================================
   CAMERA
========================================= */

const camera =
    new THREE.PerspectiveCamera(
        65,
        window.innerWidth /
        window.innerHeight,
        0.1,
        500
    );

camera.position.set(
    0,
    5.5,
    11
);


/* =========================================
   RENDERER
========================================= */

const renderer =
    new THREE.WebGLRenderer({
        antialias: true
    });

renderer.setSize(
    window.innerWidth,
    window.innerHeight
);

renderer.setPixelRatio(
    Math.min(
        window.devicePixelRatio,
        1.5
    )
);

renderer.shadowMap.enabled = true;

document.body.appendChild(
    renderer.domElement
);


/* =========================================
   LIGHT
========================================= */

const skyLight =
    new THREE.HemisphereLight(
        0xffffff,
        0x335522,
        2
    );

scene.add(skyLight);


const sun =
    new THREE.DirectionalLight(
        0xffffff,
        3
    );

sun.position.set(
    -20,
    30,
    15
);

sun.castShadow = true;

scene.add(sun);


/* =========================================
   GAME VARIABLES
========================================= */

const lanes = [
    -3,
    0,
    3
];

let currentLane = 1;

let gameRunning = false;

let score = 0;

let coins = 0;

let speed = 18;

let spawnTimer = 0;

let verticalVelocity = 0;

let grounded = true;


/* =========================================
   MATERIALS
========================================= */

const roadMaterial =
    new THREE.MeshStandardMaterial({
        color: 0x30343b
    });

const grassMaterial =
    new THREE.MeshStandardMaterial({
        color: 0x23833a
    });

const whiteMaterial =
    new THREE.MeshStandardMaterial({
        color: 0xffffff
    });

const playerMaterial =
    new THREE.MeshStandardMaterial({
        color: 0x1769ff
    });

const skinMaterial =
    new THREE.MeshStandardMaterial({
        color: 0xffc18a
    });

const obstacleMaterial =
    new THREE.MeshStandardMaterial({
        color: 0xe53935
    });

const coinMaterial =
    new THREE.MeshStandardMaterial({
        color: 0xffd21c,
        metalness: 0.7,
        roughness: 0.2
    });


/* =========================================
   ROAD
========================================= */

const road =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            12,
            0.3,
            500
        ),
        roadMaterial
    );

road.position.set(
    0,
    -0.2,
    -180
);

road.receiveShadow = true;

scene.add(road);


/* Lane lines */

for (
    const x of [-1.5, 1.5]
) {

    const line =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                0.1,
                0.04,
                500
            ),
            whiteMaterial
        );

    line.position.set(
        x,
        0,
        -180
    );

    scene.add(line);
}


/* Grass */

const grass =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            45,
            0.2,
            500
        ),
        grassMaterial
    );

grass.position.set(
    0,
    -0.35,
    -180
);

scene.add(grass);


/* =========================================
   TREES
========================================= */

const scenery = [];

function createTree(
    x,
    z
) {

    const tree =
        new THREE.Group();


    const trunk =
        new THREE.Mesh(
            new THREE.CylinderGeometry(
                0.3,
                0.45,
                2.5,
                8
            ),
            new THREE.MeshStandardMaterial({
                color: 0x70431f
            })
        );

    trunk.position.y =
        1.1;


    const leaves =
        new THREE.Mesh(
            new THREE.ConeGeometry(
                1.7,
                3.5,
                8
            ),
            new THREE.MeshStandardMaterial({
                color: 0x12652e
            })
        );

    leaves.position.y =
        3.4;


    tree.add(
        trunk,
        leaves
    );


    tree.position.set(
        x,
        0,
        z
    );


    scene.add(tree);

    scenery.push(tree);
}


for (
    let z = -10;
    z > -200;
    z -= 14
) {

    createTree(
        -10,
        z
    );

    createTree(
        10,
        z - 6
    );
}


/* =========================================
   PLAYER
========================================= */

const player =
    new THREE.Group();


const body =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            1.2,
            1.8,
            0.8
        ),
        playerMaterial
    );

body.position.y = 1.5;


const head =
    new THREE.Mesh(
        new THREE.SphereGeometry(
            0.5,
            16,
            16
        ),
        skinMaterial
    );

head.position.y = 2.8;


const leg1 =
    new THREE.Mesh(
        new THREE.BoxGeometry(
            0.35,
            1,
            0.4
        ),
        playerMaterial
    );


const leg2 =
    leg1.clone();


leg1.position.set(
    -0.3,
    0.5,
    0
);

leg2.position.set(
    0.3,
    0.5,
    0
);


player.add(
    body,
    head,
    leg1,
    leg2
);


player.position.set(
    0,
    0,
    5
);


scene.add(player);


/* =========================================
   OBJECT ARRAYS
========================================= */

const obstacles = [];

const coinsList = [];


/* =========================================
   CREATE OBSTACLE
========================================= */

function createObstacle(
    lane,
    z
) {

    const obstacle =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                1.9,
                2,
                1.7
            ),
            obstacleMaterial
        );


    obstacle.position.set(
        lanes[lane],
        1,
        z
    );


    scene.add(
        obstacle
    );


    obstacles.push(
        obstacle
    );
}


/* =========================================
   CREATE COIN
========================================= */

function createCoin(
    lane,
    z
) {

    const coin =
        new THREE.Mesh(
            new THREE.TorusGeometry(
                0.45,
                0.13,
                10,
                20
            ),
            coinMaterial
        );


    coin.rotation.y =
        Math.PI / 2;


    coin.position.set(
        lanes[lane],
        1.5,
        z
    );


    scene.add(
        coin
    );


    coinsList.push(
        coin
    );
}


/* =========================================
   SPAWN
========================================= */

function spawnObjects() {

    const z =
        -100 -
        Math.random() * 25;


    const lane =
        Math.floor(
            Math.random() * 3
        );


    if (
        Math.random() < 0.65
    ) {

        createObstacle(
            lane,
            z
        );

    } else {

        createCoin(
            lane,
            z
        );
    }


    /* Coin trail */

    if (
        Math.random() < 0.45
    ) {

        for (
            let i = 1;
            i < 5;
            i++
        ) {

            createCoin(
                lane,
                z - i * 3
            );
        }
    }
}


/* =========================================
   MOVEMENT
========================================= */

function moveLeft() {

    if (!gameRunning)
        return;


    currentLane--;

    if (
        currentLane < 0
    ) {

        currentLane = 0;
    }
}


function moveRight() {

    if (!gameRunning)
        return;


    currentLane++;

    if (
        currentLane > 2
    ) {

        currentLane = 2;
    }
}


function jump() {

    if (
        !gameRunning ||
        !grounded
    ) {

        return;
    }


    grounded = false;

    verticalVelocity = 11;
}


/* =========================================
   COLLISION
========================================= */

function collision(
    a,
    b
) {

    const x =
        Math.abs(
            a.position.x -
            b.position.x
        );

    const y =
        Math.abs(
            (a.position.y + 1.3) -
            (b.position.y + 1)
        );

    const z =
        Math.abs(
            a.position.z -
            b.position.z
        );


    return (
        x < 1.35 &&
        y < 1.8 &&
        z < 1.5
    );
}


/* =========================================
   START GAME
========================================= */

function startGame() {

    /* Remove old objects */

    obstacles.forEach(
        object =>
            scene.remove(object)
    );

    coinsList.forEach(
        object =>
            scene.remove(object)
    );


    obstacles.length = 0;

    coinsList.length = 0;


    /* Reset */

    currentLane = 1;

    score = 0;

    coins = 0;

    speed = 18;

    spawnTimer = 0;

    verticalVelocity = 0;

    grounded = true;


    player.position.set(
        0,
        0,
        5
    );


    gameRunning = true;


    document.getElementById(
        "menu"
    ).style.display = "none";


    document.getElementById(
        "gameOver"
    ).style.display = "none";
}


/* =========================================
   GAME OVER
========================================= */

function gameOver() {

    gameRunning = false;


    document.getElementById(
        "finalScore"
    ).textContent =
        Math.floor(score);


    document.getElementById(
        "gameOver"
    ).style.display = "flex";
}


/* =========================================
   BUTTONS
========================================= */

document.getElementById(
    "startButton"
).onclick =
    startGame;


document.getElementById(
    "restartButton"
).onclick =
    startGame;


document.getElementById(
    "leftButton"
).onpointerdown =
    moveLeft;


document.getElementById(
    "rightButton"
).onpointerdown =
    moveRight;


document.getElementById(
    "jumpButton"
).onpointerdown =
    jump;


/* =========================================
   KEYBOARD
========================================= */

window.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key ===
            "ArrowLeft"
        ) {

            moveLeft();
        }


        if (
            event.key ===
            "ArrowRight"
        ) {

            moveRight();
        }


        if (
            event.key ===
            "ArrowUp" ||
            event.key === " "
        ) {

            jump();
        }

    }
);


/* =========================================
   GAME LOOP
========================================= */

let lastTime =
    performance.now();


function gameLoop(
    currentTime
) {

    requestAnimationFrame(
        gameLoop
    );


    const delta =
        Math.min(
            (currentTime -
                lastTime) / 1000,
            0.05
        );


    lastTime =
        currentTime;


    if (
        gameRunning
    ) {

        /* Player lane movement */

        player.position.x +=
            (
                lanes[currentLane] -
                player.position.x
            ) *
            Math.min(
                delta * 10,
                1
            );


        /* Jump */

        if (
            !grounded
        ) {

            player.position.y +=
                verticalVelocity *
                delta;


            verticalVelocity -=
                28 * delta;


            if (
                player.position.y <= 0
            ) {

                player.position.y = 0;

                verticalVelocity = 0;

                grounded = true;
            }
        }


        /* Move scenery */

        scenery.forEach(
            tree => {

                tree.position.z +=
                    speed * delta;


                if (
                    tree.position.z > 30
                ) {

                    tree.position.z =
                        -200 -
                        Math.random() * 40;
                }
            }
        );


        /* Move obstacles */

        obstacles.forEach(
            obstacle => {

                obstacle.position.z +=
                    speed * delta;
            }
        );


        /* Move coins */

        coinsList.forEach(
            coin => {

                coin.position.z +=
                    speed * delta;


                coin.rotation.z +=
                    delta * 5;
            }
        );


        /* Spawn */

        spawnTimer -= delta;


        if (
            spawnTimer <= 0
        ) {

            spawnObjects();


            spawnTimer =
                Math.max(
                    0.65,
                    1.25 -
                    speed * 0.012
                );
        }


        /* Increase difficulty */

        speed +=
            delta * 0.3;


        score +=
            delta *
            speed *
            0.2;


        /* Obstacles */

        for (
            let i =
                obstacles.length - 1;
            i >= 0;
            i--
        ) {

            const obstacle =
                obstacles[i];


            if (
                obstacle.position.z >
                30
            ) {

                scene.remove(
                    obstacle
                );

                obstacles.splice(
                    i,
                    1
                );

            } else if (
                collision(
                    player,
                    obstacle
                )
            ) {

                gameOver();

                break;
            }
        }


        /* Coins */

        for (
            let i =
                coinsList.length - 1;
            i >= 0;
            i--
        ) {

            const coin =
                coinsList[i];


            if (
                coin.position.z >
                30
            ) {

                scene.remove(
                    coin
                );

                coinsList.splice(
                    i,
                    1
                );

            } else {

                const closeX =
                    Math.abs(
                        coin.position.x -
                        player.position.x
                    ) < 1.1;


                const closeZ =
                    Math.abs(
                        coin.position.z -
                        player.position.z
                    ) < 1.4;


                const closeY =
                    Math.abs(
                        coin.position.y -
                        (
                            player.position.y +
                            1.5
                        )
                    ) < 1.5;


                if (
                    closeX &&
                    closeZ &&
                    closeY
                ) {

                    coins++;

                    score += 25;


                    scene.remove(
                        coin
                    );


                    coinsList.splice(
                        i,
                        1
                    );
                }
            }
        }


        /* Update HUD */

        document.getElementById(
            "score"
        ).textContent =
            Math.floor(score);


        document.getElementById(
            "coins"
        ).textContent =
            coins;
    }


    /* Camera */

    camera.position.x +=
        (
            player.position.x * 0.35 -
            camera.position.x
        ) * 0.08;


    camera.position.y +=
        (
            5.5 +
            player.position.y * 0.2 -
            camera.position.y
        ) * 0.08;


    camera.lookAt(
        player.position.x * 0.15,
        1.6,
        -25
    );


    renderer.render(
        scene,
        camera
    );
}


requestAnimationFrame(
    gameLoop
);


/* =========================================
   SCREEN SIZE
========================================= */

window.addEventListener(
    "resize",
    function() {

        camera.aspect =
            window.innerWidth /
            window.innerHeight;


        camera.updateProjectionMatrix();


        renderer.setSize(
            window.innerWidth,
            window.innerHeight
        );
    }
);
