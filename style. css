* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #050816;
    color: white;
    touch-action: none;
}

canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
}

#loading,
#menu,
#gameOver {
    position: fixed;
    inset: 0;
    z-index: 20;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        radial-gradient(circle at center,
        rgba(20, 50, 100, .45),
        rgba(2, 5, 18, .96));
}

#loading {
    font-size: 34px;
    font-weight: 900;
    letter-spacing: 4px;
}

#loading small {
    margin-top: 15px;
    font-size: 14px;
    letter-spacing: 2px;
}

#menu h1 {
    font-size: 48px;
    margin: 0;
    text-shadow: 0 5px 20px rgba(0,0,0,.8);
}

#menu p {
    letter-spacing: 4px;
}

button {
    border: 0;
    border-radius: 16px;
    padding: 15px 25px;

    font-size: 18px;
    font-weight: 900;

    color: white;
    background: #1769ff;

    box-shadow:
        0 8px 25px rgba(0,0,0,.35);

    cursor: pointer;
    user-select: none;
}

button:active {
    transform: scale(.92);
}

#startButton,
#restartButton {
    margin-top: 25px;
    min-width: 220px;
}

.small {
    font-size: 13px;
    line-height: 1.8;
    opacity: .75;
}

#hud {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
}

.top-bar {
    display: flex;
    justify-content: space-around;

    padding: 18px 8px;

    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;

    background: linear-gradient(
        rgba(0,0,0,.65),
        transparent
    );
}

.top-bar div {
    text-align: center;
}

.top-bar strong {
    display: block;
    margin-top: 4px;
    font-size: 20px;
}

#pauseButton {
    position: absolute;
    top: 70px;
    right: 15px;

    width: 48px;
    height: 48px;

    padding: 0;

    pointer-events: auto;

    border-radius: 50%;
}

#powerup {
    position: absolute;
    top: 78px;
    left: 20px;

    font-size: 25px;

    opacity: 0;
}

#message {
    position: fixed;
    z-index: 15;

    left: 50%;
    top: 35%;

    transform: translate(-50%, -50%);

    font-size: 34px;
    font-weight: 900;

    text-shadow: 0 4px 12px black;

    pointer-events: none;
}

#gameOver {
    display: none;
}

#gameOver h1 {
    font-size: 48px;
    margin-bottom: 15px;
}

#gameOver p {
    margin: 6px;
    opacity: .7;
}

#gameOver strong {
    font-size: 30px;
}

#controls {
    position: fixed;
    z-index: 12;

    bottom: 20px;
    left: 0;
    right: 0;

    display: flex;
    justify-content: center;
    gap: 12px;

    pointer-events: none;
}

#controls button {
    width: 62px;
    height: 62px;

    padding: 0;

    border-radius: 50%;

    background: rgba(20, 35, 65, .72);
    border: 2px solid rgba(255,255,255,.25);

    backdrop-filter: blur(5px);

    pointer-events: auto;
}

@media (max-height: 600px) {

    #controls {
        bottom: 8px;
    }

    #controls button {
        width: 52px;
        height: 52px;
    }

    #menu h1 {
        font-size: 38px;
    }
}
