* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;

    background: #07111f;

    font-family: Arial, sans-serif;
    color: white;

    touch-action: none;
}

canvas {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;
}

/* HUD */

#hud {
    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    z-index: 10;

    padding: 16px;

    display: flex;
    justify-content: space-around;

    font-weight: bold;
    font-size: 16px;

    background: linear-gradient(
        rgba(0,0,0,0.7),
        transparent
    );
}

/* MENU */

#menu,
#gameOver {
    position: fixed;

    inset: 0;

    z-index: 20;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;

    background: rgba(3,10,25,0.90);
}

#gameOver {
    display: none;
}

#menu h1,
#gameOver h1 {
    font-size: 44px;

    margin: 10px;

    text-shadow:
        0 5px 20px black;
}

#menu p {
    letter-spacing: 4px;

    opacity: 0.8;
}

button {
    border: none;

    border-radius: 15px;

    padding: 15px 25px;

    background: #1769ff;

    color: white;

    font-size: 18px;

    font-weight: bold;

    box-shadow:
        0 8px 25px rgba(0,0,0,0.4);
}

button:active {
    transform: scale(0.9);
}

/* MOBILE CONTROLS */

#controls {
    position: fixed;

    z-index: 15;

    left: 0;
    right: 0;

    bottom: 20px;

    display: flex;

    justify-content: center;

    gap: 15px;
}

#controls button {
    width: 65px;
    height: 65px;

    padding: 0;

    border-radius: 50%;

    background: rgba(15,35,65,0.85);

    border: 2px solid rgba(255,255,255,0.3);
}
